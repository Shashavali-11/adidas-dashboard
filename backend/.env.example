PORT=5000
# Leave MONGO_URI empty to use the built-in embedded MongoDB (no install needed).
# Or point to local MongoDB / Atlas, e.g. mongodb://127.0.0.1:27017/adidas_dashboard
MONGO_URI=
# Embedded DB is recreated and re-seeded on every start. Set true to keep it in backend/data/mongo.
EMBEDDED_DB_PERSIST=false
CLIENT_ORIGIN=http://localhost:5173

# --- Authentication (JWT) ---
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=180d
# Demo account created automatically on first start
DEMO_EMAIL=admin@adidas.com
DEMO_PASSWORD=Admin@123
